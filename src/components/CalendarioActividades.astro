---
import type { Actividad } from "../lib/api";
import { categoriaColor } from "../lib/api";

interface Props {
  actividades: Actividad[];
}

const { actividades } = Astro.props;

interface CalendarEvent {
  id: string;
  title: string;
  start: string;
  end?: string;
  allDay: boolean;
  backgroundColor: string;
  borderColor: string;
  textColor: string;
  classNames: string[];
  extendedProps: {
    lugar: string | null;
    descripcion: string | null;
    categoria: Actividad["categoria"];
    destacado: boolean;
    estado: Actividad["estado"];
    hora_inicio: string | null;
    hora_fin: string | null;
    creado_por_nombre?: string;
    fecha: string;
  };
}

const eventosVisibles = actividades.filter((a) => a.estado !== "cancelada");

const events: CalendarEvent[] = eventosVisibles.map((a) => {
  const color = categoriaColor(a.categoria);
  const hasTime = !!a.hora_inicio;
  const horaTxt = a.hora_inicio ? a.hora_inicio.slice(0, 5) : "";
  return {
    id: String(a.id),
    title: horaTxt ? `${horaTxt} · ${a.titulo}` : a.titulo,
    start: hasTime ? `${a.fecha}T${a.hora_inicio}` : a.fecha,
    end: a.hora_fin ? `${a.fecha}T${a.hora_fin}` : undefined,
    allDay: !hasTime,
    backgroundColor: a.destacado ? "rgba(212, 175, 55, 0.15)" : color,
    borderColor: a.destacado ? "#D4AF37" : color,
    textColor: a.destacado ? "#D4AF37" : "#0c121e",
    classNames: a.destacado ? ["fc-event-destacado"] : [],
    extendedProps: {
      lugar: a.lugar,
      descripcion: a.descripcion,
      categoria: a.categoria,
      destacado: a.destacado,
      estado: a.estado,
      hora_inicio: a.hora_inicio,
      hora_fin: a.hora_fin,
      creado_por_nombre: a.creado_por_nombre,
      fecha: a.fecha,
    },
  };
});

let minFecha = "";
let maxFecha = "";
for (const a of eventosVisibles) {
  if (!minFecha || a.fecha < minFecha) minFecha = a.fecha;
  if (!maxFecha || a.fecha > maxFecha) maxFecha = a.fecha;
}

const categorias = [
  { value: "culto", label: "Culto", color: categoriaColor("culto") },
  { value: "estudio", label: "Estudio", color: categoriaColor("estudio") },
  { value: "evento", label: "Evento", color: categoriaColor("evento") },
  { value: "ministerio", label: "Ministerio", color: categoriaColor("ministerio") },
  { value: "social", label: "Social", color: categoriaColor("social") },
  { value: "otro", label: "Otro", color: categoriaColor("otro") },
];
---

<section class="space-y-3">
  <header class="flex flex-wrap items-baseline justify-between gap-3 mb-2">
    <div>
      <h3 class="text-2xl font-bold text-white">Calendario</h3>
      <p class="text-xs text-slate-400 mt-1">
        Sincronizado con el sistema de gestión de la iglesia.
        <span id="cal-updated" class="text-slate-500">—</span>
      </p>
    </div>
    <div class="flex items-center gap-3">
      <label class="flex items-center gap-2 text-xs text-slate-300 cursor-pointer select-none">
        <input
          id="cal-toggle-canceladas"
          type="checkbox"
          class="w-3.5 h-3.5 rounded border-white/20 bg-transparent text-[#D4AF37] focus:ring-0 focus:ring-offset-0"
        />
        Mostrar canceladas
      </label>
      <button
        id="cal-refresh"
        type="button"
        class="text-xs text-slate-300 hover:text-white border border-white/10 hover:border-white/30 rounded-full px-3 py-1 transition flex items-center gap-1"
        title="Refrescar actividades del rango visible"
      >
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
        </svg>
        Refrescar
      </button>
    </div>
  </header>

  <div class="flex flex-wrap gap-2 text-[11px]">
    {categorias.map((c) => (
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-white/5 text-slate-300">
        <span class="w-2 h-2 rounded-full" style={`background:${c.color}`}></span>
        {c.label}
      </span>
    ))}
    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[#D4AF37]/15 text-[#D4AF37]">
      <span class="w-2 h-2 rounded-full bg-[#D4AF37]"></span>
      Destacado
    </span>
  </div>

  <div
    id="calendario-actividades"
    class="rounded-2xl border border-white/5 bg-[#0c121e]/60 p-4 min-h-[600px] relative"
  >
    <div
      id="cal-loading"
      class="hidden absolute inset-0 z-20 bg-[#0c121e]/70 backdrop-blur-sm rounded-2xl flex items-center justify-center"
    >
      <div class="flex items-center gap-3 text-slate-300 text-sm">
        <span class="inline-block w-4 h-4 border-2 border-white/20 border-t-[#D4AF37] rounded-full animate-spin"></span>
        Cargando actividades…
      </div>
    </div>
    <div
      id="cal-error"
      class="hidden absolute inset-x-4 top-4 z-20 rounded-xl border border-red-500/30 bg-red-500/10 text-red-200 text-sm px-4 py-3"
    >
      <p class="font-semibold">No se pudieron cargar las actividades.</p>
      <p class="text-red-300/80 text-xs mt-1">Intentá de nuevo en unos minutos.</p>
    </div>
  </div>
</section>

<!-- Modal de detalle -->
<div
  id="cal-modal"
  class="hidden fixed inset-0 z-[100] items-center justify-center p-4 bg-black/70 backdrop-blur-sm"
  aria-hidden="true"
>
  <div class="bg-[#0c121e] border border-white/10 rounded-2xl max-w-lg w-full p-6 shadow-2xl relative">
    <button
      id="cal-modal-close"
      type="button"
      class="absolute top-3 right-3 text-slate-400 hover:text-white w-8 h-8 rounded-full hover:bg-white/5 flex items-center justify-center"
      aria-label="Cerrar"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="flex items-start gap-2 mb-2">
      <span id="cal-modal-cat" class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full font-semibold"></span>
      <span id="cal-modal-dest" class="hidden text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#D4AF37]/15 text-[#D4AF37] font-semibold">
        Destacado
      </span>
    </div>
    <h3 id="cal-modal-title" class="text-xl font-bold text-white mb-4 leading-tight"></h3>

    <div class="space-y-2 text-sm">
      <p id="cal-modal-date" class="text-slate-300 flex items-center gap-2"></p>
      <p id="cal-modal-lugar" class="text-slate-300 flex items-center gap-2"></p>
      <div id="cal-modal-desc-wrap" class="hidden border-t border-white/10 pt-3 mt-3">
        <p class="text-[10px] uppercase tracking-wider text-slate-500 mb-1">Descripción</p>
        <p id="cal-modal-desc" class="text-slate-300 whitespace-pre-line"></p>
      </div>
      <p id="cal-modal-creador" class="hidden text-[10px] text-slate-500 pt-2 border-t border-white/10 mt-3"></p>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

<script
  is:inline
  define:vars={{
    initialEvents: events,
    initialRange: { desde: minFecha, hasta: maxFecha },
  }}
>
  (function () {
    const el = document.getElementById("calendario-actividades");
    const loadingEl = document.getElementById("cal-loading");
    const errorEl = document.getElementById("cal-error");
    if (!el || !window.FullCalendar) return;

    const cache = new Map();
    if (initialRange && initialRange.desde && initialRange.hasta) {
      cache.set(initialRange.desde + "|" + initialRange.hasta + "|0", {
        ts: Date.now(),
        data: initialEvents,
      });
    }

    const updatedEl = document.getElementById("cal-updated");
    let ultimaActualizacion = Date.now();
    function setUltimaActualizacion(ts) {
      ultimaActualizacion = ts;
      renderUpdated();
    }
    function renderUpdated() {
      if (!updatedEl) return;
      const diff = Math.max(0, Math.floor((Date.now() - ultimaActualizacion) / 1000));
      if (diff < 5) updatedEl.textContent = "· actualizado hace unos segundos";
      else if (diff < 60) updatedEl.textContent = "· actualizado hace " + diff + "s";
      else if (diff < 3600)
        updatedEl.textContent =
          "· actualizado hace " + Math.floor(diff / 60) + " min";
      else
        updatedEl.textContent =
          "· actualizado hace " + Math.floor(diff / 3600) + " h";
    }
    setInterval(renderUpdated, 15000);
    renderUpdated();

    let incluirCanceladas = false;

    function toDateStr(value) {
      if (!value) return "";
      return String(value).slice(0, 10);
    }

    function isInsideRange(fecha, desde, hasta) {
      return fecha >= desde && fecha <= hasta;
    }

    async function fetchRange(desde, hasta, opts) {
      opts = opts || {};
      const key = desde + "|" + hasta + "|" + (opts.incluirCanceladas ? "1" : "0");
      const cached = cache.get(key);
      const TTL = 30 * 1000;
      if (!opts.bypassCache && cached && Date.now() - cached.ts < TTL) {
        return cached.data;
      }
      const url =
        "https://api.micasajems.com/api/get_actividades.php" +
        "?desde=" +
        encodeURIComponent(desde) +
        "&hasta=" +
        encodeURIComponent(hasta) +
        (opts.incluirCanceladas ? "&incluir_canceladas=1" : "");
      const controller = new AbortController();
      const timeoutId = setTimeout(function () {
        controller.abort();
      }, 9000);
      let res;
      try {
        res = await fetch(url, {
          method: "GET",
          headers: { Accept: "application/json" },
          signal: controller.signal,
        });
      } finally {
        clearTimeout(timeoutId);
      }
      if (!res.ok) {
        throw new Error("HTTP " + res.status);
      }
      const data = await res.json();
      if (!Array.isArray(data)) {
        throw new Error("Respuesta no válida");
      }
      const mapped = data.map(toFcEvent).filter(function (e) {
        return opts.incluirCanceladas || e.extendedProps.estado !== "cancelada";
      });
      cache.set(key, { ts: Date.now(), data: mapped });
      setUltimaActualizacion(Date.now());
      return mapped;
    }

    function toFcEvent(a) {
      const cat = a.categoria || "otro";
      const color = CATEGORIA_COLORES[cat] || "#94a3b8";
      const hasTime = !!a.hora_inicio;
      const horaTxt = hasTime ? String(a.hora_inicio).slice(0, 5) : "";
      const destacado = Boolean(Number(a.destacado) || a.destacado === true);
      return {
        id: String(a.id),
        title: horaTxt ? horaTxt + " · " + a.titulo : a.titulo,
        start: hasTime ? a.fecha + "T" + a.hora_inicio : a.fecha,
        end: a.hora_fin ? a.fecha + "T" + a.hora_fin : undefined,
        allDay: !hasTime,
        backgroundColor: destacado ? "rgba(212, 175, 55, 0.15)" : color,
        borderColor: destacado ? "#D4AF37" : color,
        textColor: destacado ? "#D4AF37" : "#0c121e",
        classNames: destacado ? ["fc-event-destacado"] : [],
        extendedProps: {
          lugar: a.lugar || null,
          descripcion: a.descripcion || null,
          categoria: cat,
          destacado: destacado,
          estado: a.estado || "programada",
          hora_inicio: a.hora_inicio || null,
          hora_fin: a.hora_fin || null,
          creado_por_nombre: a.creado_por_nombre || null,
          fecha: a.fecha,
          id: a.id,
        },
      };
    }

    const CATEGORIA_COLORES = {
      culto: "#D4AF37",
      estudio: "#60a5fa",
      evento: "#f472b6",
      ministerio: "#a78bfa",
      social: "#34d399",
      otro: "#94a3b8",
    };

    const CATEGORIA_LABELS = {
      culto: "Culto",
      estudio: "Estudio Bíblico",
      evento: "Evento",
      ministerio: "Ministerio",
      social: "Acción Social",
      otro: "Otro",
    };

    const calendar = new FullCalendar.Calendar(el, {
      initialView: "dayGridMonth",
      locale: "es",
      firstDay: 1,
      height: 650,
      headerToolbar: {
        left: "prev,next today",
        center: "title",
        right: "dayGridMonth,timeGridWeek,listWeek",
      },
      buttonText: {
        today: "Hoy",
        month: "Mes",
        week: "Semana",
        list: "Lista",
      },
      eventDidMount: function (info) {
        const p = info.event.extendedProps || {};
        const lines = [];
        lines.push(info.event.title);
        if (p.lugar) lines.push("📍 " + p.lugar);
        if (p.estado === "cancelada") lines.push("❌ CANCELADA");
        if (p.destacado) lines.push("⭐ Destacado");
        info.el.title = lines.join("\n");
        if (p.estado === "cancelada") {
          info.el.style.textDecoration = "line-through";
          info.el.style.opacity = "0.7";
        }
      },
      eventClick: function (info) {
        info.jsEvent.preventDefault();
        openModal(info.event);
      },
      noEventsContent: function () {
        return "No hay actividades programadas en este rango.";
      },
    });
    calendar.render();

    function setLoading(isLoading) {
      if (!loadingEl) return;
      if (isLoading) {
        loadingEl.classList.remove("hidden");
        loadingEl.classList.add("flex");
        if (errorEl) errorEl.classList.add("hidden");
      } else {
        loadingEl.classList.add("hidden");
        loadingEl.classList.remove("flex");
      }
    }

    let currentRangeKey = null;

    function getCurrentRange() {
      const view = calendar.view;
      const desde = toDateStr(view.activeStart.toISOString());
      const hasta = toDateStr(view.activeEnd.toISOString());
      return {
        desde,
        hasta,
        key: desde + "|" + hasta + "|" + (incluirCanceladas ? "1" : "0"),
      };
    }

    async function loadRange(opts) {
      const { desde, hasta, key, bypassCache, showLoading } = opts;
      const cached = cache.get(key);
      if (!bypassCache && cached && Date.now() - cached.ts < 30 * 1000) {
        calendar.removeAllEvents();
        calendar.addEventSource(cached.data);
        currentRangeKey = key;
        return;
      }
      if (showLoading) setLoading(true);
      try {
        if (errorEl) errorEl.classList.add("hidden");
        const events = await fetchRange(desde, hasta, {
          incluirCanceladas,
          bypassCache: !!bypassCache,
        });
        // Si el usuario ya navegó a otro rango, descartamos el resultado.
        if (key === getCurrentRange().key) {
          calendar.removeAllEvents();
          calendar.addEventSource(events);
          currentRangeKey = key;
        }
      } catch (err) {
        console.warn("[calendario] error cargando rango", desde, hasta, err);
        if (errorEl) errorEl.classList.remove("hidden");
      } finally {
        if (showLoading) setLoading(false);
      }
    }

    // 1) Pintamos el SSR apenas carga la página (instantáneo, sin loading).
    if (initialEvents.length > 0) {
      calendar.addEventSource({ id: "ssr", events: initialEvents });
      const r0 = getCurrentRange();
      currentRangeKey = r0.key;
    }

    // 2) 250 ms después, vamos a la API real para reflejar altas/bajas.
    setTimeout(function () {
      const r = getCurrentRange();
      loadRange({ ...r, bypassCache: true, showLoading: false });
    }, 250);

    // 3) Al cambiar de mes / semana / vista, recargamos desde la API.
    calendar.on("datesSet", function () {
      const r = getCurrentRange();
      const cached = cache.get(r.key);
      if (cached && Date.now() - cached.ts < 30 * 1000 && currentRangeKey === r.key) {
        return;
      }
      loadRange({ ...r, bypassCache: false, showLoading: true });
    });

    function getCurrentRange() {
      const view = calendar.view;
      return {
        desde: toDateStr(view.activeStart.toISOString()),
        hasta: toDateStr(view.activeEnd.toISOString()),
      };
    }

    // Al volver a la pestaña o recuperar el foco, invalidar caché y refetch.
    function onRevalidateEvent() {
      cache.clear();
      const r = getCurrentRange();
      loadRange({ ...r, bypassCache: true, showLoading: false });
    }
    document.addEventListener("visibilitychange", function () {
      if (!document.hidden) onRevalidateEvent();
    });
    window.addEventListener("focus", onRevalidateEvent);

    const refreshBtn = document.getElementById("cal-refresh");
    if (refreshBtn) {
      refreshBtn.addEventListener("click", function () {
        cache.clear();
        const r = getCurrentRange();
        loadRange({ ...r, bypassCache: true, showLoading: true });
      });
    }

    const toggleCanceladas = document.getElementById("cal-toggle-canceladas");
    if (toggleCanceladas) {
      toggleCanceladas.addEventListener("change", function () {
        incluirCanceladas = toggleCanceladas.checked;
        // Limpiamos la caché del modo anterior para forzar fetch fresco.
        cache.clear();
        const r = getCurrentRange();
        loadRange({ ...r, bypassCache: true, showLoading: true });
      });
    }

    const modal = document.getElementById("cal-modal");
    const modalClose = document.getElementById("cal-modal-close");
    const mTitle = document.getElementById("cal-modal-title");
    const mCat = document.getElementById("cal-modal-cat");
    const mDest = document.getElementById("cal-modal-dest");
    const mDate = document.getElementById("cal-modal-date");
    const mLugar = document.getElementById("cal-modal-lugar");
    const mDescWrap = document.getElementById("cal-modal-desc-wrap");
    const mDesc = document.getElementById("cal-modal-desc");
    const mCreador = document.getElementById("cal-modal-creador");

    function openModal(event) {
      const p = event.extendedProps || {};
      if (mTitle) mTitle.textContent = event.title.replace(/^\d{1,2}:\d{2}\s·\s/, "");

      if (mCat) {
        const color = CATEGORIA_COLORES[p.categoria] || "#94a3b8";
        mCat.textContent = CATEGORIA_LABELS[p.categoria] || p.categoria;
        mCat.style.background = color + "22";
        mCat.style.color = color;
      }
      if (mDest) {
        if (p.destacado) mDest.classList.remove("hidden");
        else mDest.classList.add("hidden");
      }
      if (mDate) {
        const fechaLarga = formatFechaLarga(p.fecha);
        const hora =
          p.hora_inicio && p.hora_fin
            ? p.hora_inicio.slice(0, 5) + " – " + p.hora_fin.slice(0, 5)
            : p.hora_inicio
              ? p.hora_inicio.slice(0, 5) + " hs"
              : "Todo el día";
        mDate.innerHTML =
          '<svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg><span>' +
          fechaLarga +
          " · " +
          hora +
          "</span>";
      }
      if (mLugar) {
        if (p.lugar) {
          mLugar.classList.remove("hidden");
          mLugar.innerHTML =
            '<svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg><span>' +
            escapeHtml(p.lugar) +
            "</span>";
        } else {
          mLugar.classList.add("hidden");
        }
      }
      if (mDesc && mDescWrap) {
        if (p.descripcion) {
          mDesc.textContent = p.descripcion;
          mDescWrap.classList.remove("hidden");
        } else {
          mDesc.textContent = "Cargando detalle…";
          mDescWrap.classList.remove("hidden");
        }
      }
      if (mCreador) {
        if (p.creado_por_nombre) {
          mCreador.textContent = "Publicada por " + p.creado_por_nombre;
          mCreador.classList.remove("hidden");
        } else {
          mCreador.classList.add("hidden");
        }
      }

      if (modal) {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        modal.setAttribute("aria-hidden", "false");
      }

      if (p.id) {
        const id = p.id;
        const url =
          "https://api.micasajems.com/api/get_actividad.php?id=" + encodeURIComponent(String(id));
        fetch(url, { headers: { Accept: "application/json" } })
          .then(function (r) {
            if (!r.ok) throw new Error("HTTP " + r.status);
            return r.json();
          })
          .then(function (full) {
            if (!full || typeof full !== "object") return;
            if (mDesc && full.descripcion) {
              mDesc.textContent = full.descripcion;
            }
            if (full.creado_por_nombre && mCreador) {
              mCreador.textContent = "Publicada por " + full.creado_por_nombre;
              mCreador.classList.remove("hidden");
            }
          })
          .catch(function (err) {
            console.warn("[calendario] no se pudo obtener el detalle", err);
            if (mDesc && !p.descripcion) {
              mDesc.textContent = "No se pudo obtener la descripción completa.";
            }
          });
      }
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      modal.setAttribute("aria-hidden", "true");
    }

    if (modalClose) modalClose.addEventListener("click", closeModal);
    if (modal) {
      modal.addEventListener("click", function (e) {
        if (e.target === modal) closeModal();
      });
    }
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeModal();
    });

    function formatFechaLarga(fecha) {
      if (!fecha) return "";
      const d = new Date(fecha + "T00:00:00");
      const dias = ["domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado"];
      const meses = [
        "enero", "febrero", "marzo", "abril", "mayo", "junio",
        "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre",
      ];
      return (
        dias[d.getDay()] +
        " " +
        d.getDate() +
        " de " +
        meses[d.getMonth()] +
        " de " +
        d.getFullYear()
      );
    }

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }
  })();
</script>

