---
import type { Actividad } from "../lib/api";
import { categoriaColor } from "../lib/api";

interface Props {
  actividades: Actividad[];
}

const { actividades } = Astro.props;

const LEYENDA = [
  { value: "culto", label: "Culto" },
  { value: "estudio", label: "Estudio" },
  { value: "evento", label: "Evento" },
  { value: "ministerio", label: "Ministerio" },
  { value: "social", label: "Social" },
  { value: "otro", label: "Otro" },
];

const events = actividades
  .filter((a) => a.estado !== "cancelada")
  .map((a) => {
    const color = categoriaColor(a.categoria);
    const hasTime = !!a.hora_inicio;
    const hora = a.hora_inicio?.slice(0, 5) ?? "";
    return {
      id: String(a.id),
      title: hora ? `${hora} · ${a.titulo}` : a.titulo,
      start: hasTime ? `${a.fecha}T${a.hora_inicio}` : a.fecha,
      end: a.hora_fin ? `${a.fecha}T${a.hora_fin}` : undefined,
      allDay: !hasTime,
      backgroundColor: a.destacado ? "rgba(212, 175, 55, 0.15)" : color,
      borderColor: a.destacado ? "#D4AF37" : color,
      textColor: a.destacado ? "#D4AF37" : "#0c121e",
      classNames: a.destacado ? ["fc-event-destacado"] : [],
      extendedProps: {
        lugar: a.lugar,
        descripcion: a.descripcion,
        categoria: a.categoria,
        destacado: a.destacado,
        estado: a.estado,
        hora_inicio: a.hora_inicio,
        hora_fin: a.hora_fin,
        creado_por_nombre: a.creado_por_nombre,
        fecha: a.fecha,
      },
    };
  });
---

<section class="space-y-3">
  <header class="flex flex-wrap items-baseline justify-between gap-3 mb-2">
    <div>
      <h3 class="text-2xl font-bold text-white">Calendario</h3>
      <p class="text-xs text-slate-400 mt-1">
        Sincronizado con el sistema de gestión de la iglesia.
        <span id="cal-updated" class="text-slate-500">—</span>
      </p>
    </div>
    <div class="flex items-center gap-3">
      <label class="flex items-center gap-2 text-xs text-slate-300 cursor-pointer select-none">
        <input
          id="cal-toggle-canceladas"
          type="checkbox"
          class="w-3.5 h-3.5 rounded border-white/20 bg-transparent text-[#D4AF37] focus:ring-0 focus:ring-offset-0"
        />
        Mostrar canceladas
      </label>
      <button
        id="cal-refresh"
        type="button"
        class="text-xs text-slate-300 hover:text-white border border-white/10 hover:border-white/30 rounded-full px-3 py-1 transition flex items-center gap-1"
        title="Refrescar actividades del rango visible"
      >
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
          ></path>
        </svg>
        Refrescar
      </button>
    </div>
  </header>

  <div class="flex flex-wrap gap-2 text-[11px]">
    {
      LEYENDA.map((c) => (
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-white/5 text-slate-300">
          <span class="w-2 h-2 rounded-full" style={`background:${categoriaColor(c.value)}`} />
          {c.label}
        </span>
      ))
    }
    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[#D4AF37]/15 text-[#D4AF37]">
      <span class="w-2 h-2 rounded-full bg-[#D4AF37]"></span>
      Destacado
    </span>
  </div>

  <div id="calendario-actividades" class="rounded-2xl border border-white/5 bg-[#0c121e]/60 p-4 min-h-[600px] relative">
    <div
      id="cal-loading"
      class="hidden absolute inset-0 z-20 bg-[#0c121e]/30 backdrop-blur-[2px] rounded-2xl flex items-center justify-center pointer-events-none"
    >
      <div class="flex items-center gap-3 text-slate-300 text-sm">
        <span class="inline-block w-4 h-4 border-2 border-white/20 border-t-[#D4AF37] rounded-full animate-spin"></span>
        Cargando actividades…
      </div>
    </div>
    <div
      id="cal-error"
      class="hidden absolute inset-x-4 top-4 z-20 rounded-xl border border-red-500/30 bg-red-500/10 text-red-200 text-sm px-4 py-3"
    >
      <p class="font-semibold">No se pudieron cargar las actividades.</p>
      <p class="text-red-300/80 text-xs mt-1">Intentá de nuevo en unos minutos.</p>
    </div>
  </div>
</section>

<div
  id="cal-modal"
  class="hidden fixed inset-0 z-[100] items-center justify-center p-4 bg-black/70 backdrop-blur-sm"
  aria-hidden="true"
>
  <div class="bg-[#0c121e] border border-white/10 rounded-2xl max-w-lg w-full p-6 shadow-2xl relative">
    <button
      id="cal-modal-close"
      type="button"
      class="absolute top-3 right-3 text-slate-400 hover:text-white w-8 h-8 rounded-full hover:bg-white/5 flex items-center justify-center"
      aria-label="Cerrar"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="flex items-start gap-2 mb-2">
      <span id="cal-modal-cat" class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full font-semibold"
      ></span>
      <span
        id="cal-modal-dest"
        class="hidden text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#D4AF37]/15 text-[#D4AF37] font-semibold"
      >
        Destacado
      </span>
    </div>
    <h3 id="cal-modal-title" class="text-xl font-bold text-white mb-4 leading-tight"></h3>

    <div class="space-y-2 text-sm">
      <p id="cal-modal-date" class="text-slate-300 flex items-center gap-2"></p>
      <p id="cal-modal-lugar" class="text-slate-300 flex items-center gap-2"></p>
      <div id="cal-modal-desc-wrap" class="hidden border-t border-white/10 pt-3 mt-3">
        <p class="text-[10px] uppercase tracking-wider text-slate-500 mb-1">Descripción</p>
        <p id="cal-modal-desc" class="text-slate-300 whitespace-pre-line"></p>
      </div>
      <p id="cal-modal-creador" class="hidden text-[10px] text-slate-500 pt-2 border-t border-white/10 mt-3"></p>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

<script is:inline define:vars={{ initialEvents: events }}>
  (function () {
    const el = document.getElementById("calendario-actividades");
    if (!el || !window.FullCalendar) return;

    const SOURCE_ID = "api";
    const API_BASE = "https://api.micasajems.com/api";
    const CACHE_TTL = 30_000;
    const FETCH_TIMEOUT = 9_000;
    const DAY_MS = 86_400_000;
    const DEFAULT_COLOR = "#94a3b8";

    const COLORES = {
      culto: "#D4AF37",
      estudio: "#60a5fa",
      evento: "#f472b6",
      ministerio: "#a78bfa",
      social: "#34d399",
      otro: "#94a3b8",
    };
    const ETIQUETAS = {
      culto: "Culto",
      estudio: "Estudio Bíblico",
      evento: "Evento",
      ministerio: "Ministerio",
      social: "Acción Social",
      otro: "Otro",
    };
    const DIAS = ["domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado"];
    const MESES = [
      "enero",
      "febrero",
      "marzo",
      "abril",
      "mayo",
      "junio",
      "julio",
      "agosto",
      "septiembre",
      "octubre",
      "noviembre",
      "diciembre",
    ];

    const ICON_CALENDAR =
      '<svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>';
    const ICON_PIN =
      '<svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>';

    const $ = (id) => document.getElementById(id);
    const toDateStr = (v) => (v ? String(v).slice(0, 10) : "");
    const isValidDate = (s) => typeof s === "string" && /^\d{4}-\d{2}-\d{2}$/.test(s);
    const isValidTime = (s) => s != null && /^\d{2}:\d{2}(:\d{2})?$/.test(String(s));
    const sameIds = (a, b) => a.size === b.size && [...a].every((id) => b.has(id));
    const escapeHtml = (s) =>
      String(s).replace(
        /[&<>"']/g,
        (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c],
      );
    const formatFechaLarga = (f) => {
      if (!f) return "";
      const d = new Date(f + "T00:00:00");
      return `${DIAS[d.getDay()]} ${d.getDate()} de ${MESES[d.getMonth()]} de ${d.getFullYear()}`;
    };

    const loadingEl = $("cal-loading");
    const errorEl = $("cal-error");
    const updatedEl = $("cal-updated");

    const cache = new Map();
    const lastValidByRange = new Map();
    const seedEvents = Array.isArray(initialEvents) ? initialEvents : [];
    let lastEventIds = new Set(seedEvents.map((e) => String(e.id)));
    let incluirCanceladas = false;
    let initialDone = false;
    let ultimaActualizacion = Date.now();

    function toFcEvent(a) {
      if (!a || !isValidDate(a.fecha)) return null;
      const cat = a.categoria || "otro";
      const color = COLORES[cat] || DEFAULT_COLOR;
      const hasTime = isValidTime(a.hora_inicio);
      const destacado = Number(a.destacado) > 0 || a.destacado === true;
      const hora = hasTime ? String(a.hora_inicio).slice(0, 5) : "";
      return {
        id: String(a.id ?? `act-${Math.random().toString(36).slice(2)}`),
        title: hora ? `${hora} · ${a.titulo || ""}` : a.titulo || "Sin título",
        start: hasTime ? `${a.fecha}T${a.hora_inicio}` : a.fecha,
        end: isValidTime(a.hora_fin) ? `${a.fecha}T${a.hora_fin}` : undefined,
        allDay: !hasTime,
        backgroundColor: destacado ? "rgba(212, 175, 55, 0.15)" : color,
        borderColor: destacado ? "#D4AF37" : color,
        textColor: destacado ? "#D4AF37" : "#0c121e",
        classNames: destacado ? ["fc-event-destacado"] : [],
        extendedProps: {
          lugar: a.lugar ?? null,
          descripcion: a.descripcion ?? null,
          categoria: cat,
          destacado,
          estado: String(a.estado || "programada").toLowerCase(),
          hora_inicio: hasTime ? String(a.hora_inicio) : null,
          hora_fin: isValidTime(a.hora_fin) ? String(a.hora_fin) : null,
          creado_por_nombre: a.creado_por_nombre ?? null,
          fecha: a.fecha,
          id: a.id,
        },
      };
    }

    const calendar = new FullCalendar.Calendar(el, {
      initialView: "dayGridMonth",
      locale: "es",
      firstDay: 1,
      height: 650,
      headerToolbar: {
        left: "prev,next today",
        center: "title",
        right: "dayGridMonth,timeGridWeek,listWeek",
      },
      buttonText: { today: "Hoy", month: "Mes", week: "Semana", list: "Lista" },
      eventDidMount(info) {
        const p = info.event.extendedProps || {};
        const lines = [info.event.title];
        if (p.lugar) lines.push("📍 " + p.lugar);
        if (p.estado === "cancelada") lines.push("❌ CANCELADA");
        if (p.destacado) lines.push("⭐ Destacado");
        info.el.title = lines.join("\n");
        if (p.estado === "cancelada") {
          info.el.style.textDecoration = "line-through";
          info.el.style.opacity = "0.7";
        }
      },
      eventClick(info) {
        info.jsEvent.preventDefault();
        openModal(info.event);
      },
      noEventsContent: () => "No hay actividades programadas en este rango.",
    });
    calendar.render();

    const getCurrentRange = () => {
      const v = calendar.view;
      const desde = toDateStr(v.activeStart.toISOString());
      const hasta = toDateStr(v.activeEnd.toISOString());
      return { desde, hasta, key: `${desde}|${hasta}|${incluirCanceladas ? 1 : 0}` };
    };
    const isCurrentView = (key) => {
      try {
        return getCurrentRange().key === key;
      } catch {
        return false;
      }
    };
    const setSourceEvents = (evts) => {
      const src = calendar.getEventSourceById(SOURCE_ID);
      if (src) src.remove();
      calendar.addEventSource({ id: SOURCE_ID, events: evts || [] });
    };
    const setLoading = (on) => {
      if (!loadingEl) return;
      loadingEl.classList.toggle("hidden", !on);
      loadingEl.classList.toggle("flex", on);
      if (on && errorEl) errorEl.classList.add("hidden");
    };
    const markUpdated = () => {
      ultimaActualizacion = Date.now();
      renderUpdated();
    };
    const renderUpdated = () => {
      if (!updatedEl) return;
      const d = Math.max(0, Math.floor((Date.now() - ultimaActualizacion) / 1000));
      let txt = "· actualizado hace ";
      if (d < 5) txt += "unos segundos";
      else if (d < 60) txt += d + "s";
      else if (d < 3600) txt += Math.floor(d / 60) + " min";
      else txt += Math.floor(d / 3600) + " h";
      updatedEl.textContent = txt;
    };
    setInterval(renderUpdated, 15000);
    renderUpdated();

    async function fetchRange(desde, hasta, opts = {}) {
      const key = `${desde}|${hasta}|${opts.incluirCanceladas ? 1 : 0}`;
      const cached = cache.get(key);
      if (!opts.bypassCache && cached && Date.now() - cached.ts < CACHE_TTL) {
        return cached.data;
      }
      const url =
        `${API_BASE}/get_actividades.php?desde=${encodeURIComponent(desde)}&hasta=${encodeURIComponent(hasta)}` +
        (opts.incluirCanceladas ? "&incluir_canceladas=1" : "");
      const ctrl = new AbortController();
      const timeout = setTimeout(() => ctrl.abort(), FETCH_TIMEOUT);
      let res;
      try {
        res = await fetch(url, { method: "GET", headers: { Accept: "application/json" }, signal: ctrl.signal });
      } finally {
        clearTimeout(timeout);
      }
      if (!res.ok) throw new Error("HTTP " + res.status);
      const data = await res.json();
      if (!Array.isArray(data)) throw new Error("Respuesta no válida");
      const mapped = data
        .map(toFcEvent)
        .filter(Boolean)
        .filter((e) => opts.incluirCanceladas || e.extendedProps.estado !== "cancelada");
      cache.set(key, { ts: Date.now(), data: mapped });
      markUpdated();
      return mapped;
    }

    async function loadRange({ desde, hasta, key, bypassCache, showLoading }) {
      const cached = cache.get(key);
      if (!bypassCache && cached && Date.now() - cached.ts < CACHE_TTL) {
        if (isCurrentView(key)) {
          setSourceEvents(cached.data);
          lastEventIds = new Set(cached.data.map((e) => String(e.id)));
        }
        return;
      }
      if (showLoading) setLoading(true);
      try {
        if (errorEl) errorEl.classList.add("hidden");
        const events = await fetchRange(desde, hasta, { incluirCanceladas, bypassCache: !!bypassCache });
        if (!isCurrentView(key)) return;
        if (!Array.isArray(events)) return;
        if (events.length === 0 && lastValidByRange.has(key)) return;
        cache.set(key, { ts: Date.now(), data: events });
        if (events.length > 0) lastValidByRange.set(key, events);
        const newIds = new Set(events.map((e) => String(e.id)));
        if (!sameIds(newIds, lastEventIds)) {
          setSourceEvents(events);
          lastEventIds = newIds;
        }
        markUpdated();
      } catch (err) {
        console.warn("[calendario] error cargando rango", desde, hasta, err);
        if (isCurrentView(key) && errorEl) errorEl.classList.remove("hidden");
      } finally {
        if (showLoading) setLoading(false);
      }
    }

    function revalidate(showLoading) {
      cache.clear();
      const r = getCurrentRange();
      loadRange({ ...r, bypassCache: true, showLoading });
    }

    calendar.addEventSource({ id: SOURCE_ID, events: seedEvents });

    // **********************************************
    // *** CODIGO QUE HACIA CRASHEAR EL CALENDARIO
    // **********************************************
    // setTimeout(() => {
    //   loadRange({ ...getCurrentRange(), bypassCache: true, showLoading: false });
    //   initialDone = true;
    // }, 250);

    calendar.on("datesSet", () => {
      if (!initialDone) return;
      const view = calendar.view;
      if (view && (view.type === "timeGridWeek" || view.type === "listWeek")) {
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const start = view.activeStart instanceof Date ? view.activeStart : new Date(view.activeStart);
        if (Math.abs(start - today) / DAY_MS > 7) {
          calendar.today();
          return;
        }
      }
      const r = getCurrentRange();
      const cached = cache.get(r.key);
      if (cached && Date.now() - cached.ts < CACHE_TTL) return;
      loadRange({ ...r, bypassCache: false, showLoading: true });
    });

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) revalidate(false);
    });
    window.addEventListener("focus", () => revalidate(false));
    $("cal-refresh")?.addEventListener("click", () => revalidate(true));
    $("cal-toggle-canceladas")?.addEventListener("change", (e) => {
      incluirCanceladas = e.target.checked;
      revalidate(true);
    });

    const modal = $("cal-modal");
    const M = {
      title: $("cal-modal-title"),
      cat: $("cal-modal-cat"),
      dest: $("cal-modal-dest"),
      date: $("cal-modal-date"),
      lugar: $("cal-modal-lugar"),
      descWrap: $("cal-modal-desc-wrap"),
      desc: $("cal-modal-desc"),
      creador: $("cal-modal-creador"),
    };

    function openModal(event) {
      const p = event.extendedProps || {};
      if (M.title) M.title.textContent = event.title.replace(/^\d{1,2}:\d{2}\s·\s/, "");

      if (M.cat) {
        const color = COLORES[p.categoria] || DEFAULT_COLOR;
        M.cat.textContent = ETIQUETAS[p.categoria] || p.categoria;
        M.cat.style.background = color + "22";
        M.cat.style.color = color;
      }
      M.dest?.classList.toggle("hidden", !p.destacado);

      if (M.date) {
        const hora =
          p.hora_inicio && p.hora_fin
            ? `${p.hora_inicio.slice(0, 5)} – ${p.hora_fin.slice(0, 5)}`
            : p.hora_inicio
              ? `${p.hora_inicio.slice(0, 5)} hs`
              : "Todo el día";
        M.date.innerHTML = `${ICON_CALENDAR}<span>${formatFechaLarga(p.fecha)} · ${hora}</span>`;
      }
      if (M.lugar) {
        if (p.lugar) {
          M.lugar.classList.remove("hidden");
          M.lugar.innerHTML = `${ICON_PIN}<span>${escapeHtml(p.lugar)}</span>`;
        } else {
          M.lugar.classList.add("hidden");
        }
      }
      if (M.desc && M.descWrap) {
        M.descWrap.classList.remove("hidden");
        M.desc.textContent = p.descripcion || "Cargando detalle…";
      }
      if (M.creador) {
        if (p.creado_por_nombre) {
          M.creador.textContent = "Publicada por " + p.creado_por_nombre;
          M.creador.classList.remove("hidden");
        } else {
          M.creador.classList.add("hidden");
        }
      }

      if (modal) {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        modal.setAttribute("aria-hidden", "false");
      }

      if (p.id) {
        fetch(`${API_BASE}/get_actividad.php?id=${encodeURIComponent(String(p.id))}`, {
          headers: { Accept: "application/json" },
        })
          .then((r) => {
            if (!r.ok) throw new Error("HTTP " + r.status);
            return r.json();
          })
          .then((full) => {
            if (!full || typeof full !== "object") return;
            if (M.desc && full.descripcion) M.desc.textContent = full.descripcion;
            if (full.creado_por_nombre && M.creador) {
              M.creador.textContent = "Publicada por " + full.creado_por_nombre;
              M.creador.classList.remove("hidden");
            }
          })
          .catch((err) => {
            console.warn("[calendario] no se pudo obtener el detalle", err);
            if (M.desc && !p.descripcion) {
              M.desc.textContent = "No se pudo obtener la descripción completa.";
            }
          });
      }
    }

    const closeModal = () => {
      if (!modal) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      modal.setAttribute("aria-hidden", "true");
    };
    $("cal-modal-close")?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });
  })();
</script>

<style is:global>
  #calendario-actividades .fc {
    --fc-border-color: rgba(255, 255, 255, 0.06);
    --fc-page-bg-color: transparent;
    --fc-neutral-bg-color: rgba(255, 255, 255, 0.02);
    --fc-list-event-hover-bg-color: rgba(212, 175, 55, 0.08);
    --fc-today-bg-color: rgba(212, 175, 55, 0.08);
    --fc-event-text-color: #101829;
    --fc-button-bg-color: rgba(255, 255, 255, 0.05);
    --fc-button-border-color: rgba(255, 255, 255, 0.1);
    --fc-button-text-color: #e2e8f0;
    --fc-button-hover-bg-color: rgba(212, 175, 55, 0.2);
    --fc-button-hover-border-color: #d4af37;
    --fc-button-active-bg-color: #d4af37;
    --fc-button-active-border-color: #d4af37;
    color: #cbd5e1;
    font-family: inherit;
  }
  #calendario-actividades .fc-toolbar-title {
    color: #fff;
