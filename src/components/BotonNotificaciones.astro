---
interface Props {
  sendpulseAccountId?: string;
}

const { sendpulseAccountId } = Astro.props;

const fallbackSpId = (import.meta.env.PUBLIC_SENDPULSE_ACCOUNT_ID ?? "") as string;
const finalSpId = (sendpulseAccountId || fallbackSpId).trim();

const vapidKey = (import.meta.env.PUBLIC_VAPID_KEY ?? "") as string;
const apiBase = (import.meta.env.PUBLIC_API_URL ?? "") as string;

const useSendPulse = finalSpId !== "";
---

<section
  id="seccion-push"
  class="rounded-2xl border border-[#D4AF37]/20 bg-gradient-to-br from-[#D4AF37]/10 via-[#101829] to-[#101829] p-6 md:p-8 flex flex-col md:flex-row items-center gap-6"
>
  <div class="shrink-0 w-16 h-16 rounded-2xl bg-[#D4AF37]/15 text-[#D4AF37] flex items-center justify-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
      ></path>
    </svg>
  </div>

  <div class="flex-1 text-center md:text-left">
    <h3 class="text-xl font-bold text-white">¿Querés recibir notificaciones y avisos de las actividades?</h3>
    <p class="text-sm text-slate-300 mt-1">
      Te avisamos cada vez que publiquemos un culto, estudio bíblico o evento especial. Activá las notificaciones push
      haciendo clic en el botón.
    </p>
  </div>

  <button
    id="btn-suscribir-push"
    type="button"
    data-vapid-key={vapidKey}
    data-api-base={apiBase}
    data-sp-account-id={finalSpId}
    data-use-sendpulse={useSendPulse ? "1" : "0"}
    class="shrink-0 px-6 py-3 rounded-full bg-[#D4AF37] text-[#101829] font-bold hover:scale-105 transition shadow-2xl flex items-center gap-2"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
    </svg>
    Quiero recibir notificaciones
  </button>
</section>

<div id="push-status" class="hidden mt-3 text-sm"></div>

<script is:inline>
  (function () {
    const btn = document.getElementById("btn-suscribir-push");
    if (!btn) return;
    const status = document.getElementById("push-status");

    const vapidKey = btn.getAttribute("data-vapid-key") || "";
    const apiBase = btn.getAttribute("data-api-base") || "";
    const spAccountId = btn.getAttribute("data-sp-account-id") || "";
    const useSendPulse = btn.getAttribute("data-use-sendpulse") === "1";

    // URLs del SDK de SendPulse en orden de preferencia
    const SENDPULSE_SCRIPT_URLS = [
      "https://cdn.sendpulse.com/push/push.js",
      "https://login.sendpulse.com/push/push.js",
    ];

    btn.addEventListener("click", function () {
      if (!("serviceWorker" in navigator) || !("PushManager" in window)) {
        mostrarError("Tu navegador no soporta notificaciones push. Probá Chrome, Edge o Firefox.");
        return;
      }
      if (Notification.permission === "denied") {
        mostrarError("Las notificaciones están bloqueadas. Habilitalas en la configuración del navegador.");
        return;
      }

      btn.disabled = true;
      btn.innerHTML = "Cargando...";

      if (useSendPulse) {
        intentarSendPulse(0);
      } else {
        suscribirVAPID();
      }
    });

    // ---------- SendPulse SDK ----------
    function intentarSendPulse(intento) {
      if (window.PushSubscriber) {
        suscribirSendPulse();
        return;
      }
      if (intento >= SENDPULSE_SCRIPT_URLS.length) {
        console.warn("[Push] SendPulse SDK no disponible, cayendo a VAPID nativo");
        suscribirVAPID();
        return;
      }
      const url = SENDPULSE_SCRIPT_URLS[intento];
      console.log("[Push] intentando SendPulse SDK:", url);
      const s = document.createElement("script");
      s.src = url;
      s.async = true;
      s.onload = function () {
        console.log("[Push] SendPulse script cargado desde", url);
        // Damos un tick para que el script defina window.PushSubscriber
        setTimeout(function () {
          if (typeof window.PushSubscriber === "function") {
            suscribirSendPulse();
          } else {
            console.warn("[Push] Script cargado pero PushSubscriber no definido, cayendo a VAPID");
            suscribirVAPID();
          }
        }, 100);
      };
      s.onerror = function () {
        console.warn("[Push] falló carga desde", url);
        if (s.parentNode) s.parentNode.removeChild(s);
        intentarSendPulse(intento + 1);
      };
      document.head.appendChild(s);
    }

    function suscribirSendPulse() {
      try {
        if (typeof window.PushSubscriber !== "function") {
          console.warn("[Push] PushSubscriber no es función, cayendo a VAPID");
          suscribirVAPID();
          return;
        }
        window.pushSubscriber = new window.PushSubscriber(spAccountId);
        window.pushSubscriber
          .subscribe()
          .then(function () {
            btn.innerHTML = svgCheck();
            btn.classList.add("opacity-60", "cursor-default");
            mostrarExito(
              "¡Listo! Te suscribiste correctamente vía SendPulse. Vas a recibir los avisos de actividades."
            );
            logSuscripcion({ sendpulse_id: spAccountId });
          })
          .catch(function (err) {
            console.error("[Push] SendPulse subscribe error", err);
            const msg = err && err.message ? err.message : "desconocido";
            // Si SendPulse falla (dominio no registrado, error de cuenta, etc.),
            // caemos automáticamente a VAPID para que igual reciba notificaciones.
            mostrarAviso(
              "SendPulse no aceptó la suscripción (" +
                msg +
                "), usando canal alternativo (Web Push nativo)."
            );
            suscribirVAPID();
          });
      } catch (e) {
        console.error("[Push] SendPulse init error", e);
        suscribirVAPID();
      }
    }

    // ---------- VAPID nativo (fallback y default si no hay SendPulse) ----------
    async function suscribirVAPID() {
      if (!vapidKey) {
        mostrarError(
          "No hay clave VAPID configurada (PUBLIC_VAPID_KEY) ni credenciales SendPulse válidas. Pedile al administrador que configure al menos una."
        );
        btn.disabled = false;
        btn.innerHTML = svgBoton();
        return;
      }

      try {
        const reg = await navigator.serviceWorker.register("/sw-push.js");
        console.log("[Push] SW registrado:", reg.scope);
        await navigator.serviceWorker.ready;

        const subscription = await reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(vapidKey),
        });
        console.log("[Push] VAPID suscrito:", subscription.endpoint);

        const json = subscription.toJSON();
        const res = await fetch(apiBase + "/suscripciones", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            endpoint: json.endpoint,
            keys: { p256dh: json.keys.p256dh, auth: json.keys.auth },
            user_agent: navigator.userAgent,
            source: "webpush",
          }),
        });

        if (!res.ok) {
          throw new Error("HTTP " + res.status);
        }

        btn.innerHTML = svgCheck();
        btn.classList.add("opacity-60", "cursor-default");
        mostrarExito(
          "¡Listo! Te suscribiste correctamente. Vas a recibir los avisos de actividades."
        );
      } catch (err) {
        console.error("[Push] VAPID error:", err);
        btn.disabled = false;
        btn.innerHTML = svgBoton();
        let msg = err && err.message ? err.message : "desconocido";
        if (err && err.name === "NotAllowedError") {
          msg = "Permiso denegado. Habilitá las notificaciones en tu navegador.";
        }
        mostrarError("No se pudo completar la suscripción (" + msg + ").");
      }
    }

    // ---------- Helpers ----------
    function urlBase64ToUint8Array(base64String) {
      const padding = "=".repeat((4 - (base64String.length % 4)) % 4);
      const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
      const raw = atob(base64);
      const out = new Uint8Array(raw.length);
      for (let i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
      return out;
    }

    function svgBoton() {
      return '<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Quiero recibir notificaciones';
    }

    function svgCheck() {
      return '<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Suscripto';
    }

    function mostrarExito(msg) {
      setStatus(
        "mt-3 text-sm px-4 py-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300",
        msg
      );
    }

    function mostrarAviso(msg) {
      setStatus(
        "mt-3 text-sm px-4 py-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-300",
        msg
      );
    }

    function mostrarError(msg) {
      setStatus(
        "mt-3 text-sm px-4 py-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-300",
        msg
      );
    }

    function setStatus(classes, msg) {
      if (!status) return;
      status.className = classes;
      status.textContent = msg;
      status.classList.remove("hidden");
    }

    function logSuscripcion(extra) {
      if (!apiBase) return;
      try {
        const base = apiBase.replace(/\/$/, "");
        fetch(base + "/suscripciones", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(Object.assign({ source: "sendpulse" }, extra || {})),
          mode: "cors",
        });
      } catch (e) {
        console.warn("[Push] No se pudo loguear la suscripción:", e);
      }
    }
  })();
</script>