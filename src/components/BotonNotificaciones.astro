---
interface Props {
  accountId?: string;
}

const { accountId } = Astro.props;
const fallbackId = (import.meta.env.PUBLIC_SENDPULSE_ACCOUNT_ID ?? "") as string;
const finalAccountId = accountId || fallbackId;
const apiBase = (import.meta.env.PUBLIC_API_URL ?? "") as string;
---

<section
  id="seccion-push"
  class="rounded-2xl border border-[#D4AF37]/20 bg-gradient-to-br from-[#D4AF37]/10 via-[#101829] to-[#101829] p-6 md:p-8 flex flex-col md:flex-row items-center gap-6"
>
  <div class="shrink-0 w-16 h-16 rounded-2xl bg-[#D4AF37]/15 text-[#D4AF37] flex items-center justify-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
      ></path>
    </svg>
  </div>

  <div class="flex-1 text-center md:text-left">
    <h3 class="text-xl font-bold text-white">¿Querés recibir notificaciones y avisos de las actividades?</h3>
    <p class="text-sm text-slate-300 mt-1">
      Te avisamos cada vez que publiquemos un culto, estudio bíblico o evento especial. Activá las notificaciones push
      haciendo clic en el botón.
    </p>
  </div>

  <button
    id="btn-suscribir-push"
    type="button"
    data-account-id={finalAccountId}
    class="shrink-0 px-6 py-3 rounded-full bg-[#D4AF37] text-[#101829] font-bold hover:scale-105 transition shadow-2xl flex items-center gap-2"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
    </svg>
    Quiero recibir notificaciones
  </button>
</section>

<div id="push-status" class="hidden mt-3 text-sm" data-api-base={apiBase}></div>

<script is:inline>
  (function () {
    const btn = document.getElementById("btn-suscribir-push");
    if (!btn) return;
    const status = document.getElementById("push-status");
    const accountId = btn.getAttribute("data-account-id") || "";
    const apiBase = (status && status.getAttribute("data-api-base")) || "";

    // URLs del SDK de SendPulse, en orden de preferencia
    const SENDPULSE_SCRIPT_URLS = [
      "https://login.sendpulse.com/push/push.js",
      "https://cdn.sendpulse.com/push/push.js",
    ];

    btn.addEventListener("click", function () {
      if (!accountId) {
        mostrarError("El account_id de SendPulse no está configurado. Revisá las variables de entorno.");
        return;
      }
      if (!("serviceWorker" in navigator) || !("PushManager" in window)) {
        mostrarError("Tu navegador no soporta notificaciones push. Probá Chrome, Edge o Firefox.");
        return;
      }
      cargarScriptSendPulse(0);
    });

    function cargarScriptSendPulse(intento) {
      if (window.PushSubscriber) {
        suscribir(accountId);
        return;
      }
      if (intento >= SENDPULSE_SCRIPT_URLS.length) {
        mostrarError("No se pudo cargar el SDK de SendPulse desde ningún CDN. Verificá tu conexión o que el sitio esté registrado en SendPulse.");
        btn.disabled = false;
        btn.innerHTML = svgBoton();
        return;
      }
      const url = SENDPULSE_SCRIPT_URLS[intento];
      btn.disabled = true;
      btn.innerHTML = "Cargando...";
      console.log("[SendPulse] intentando", url);
      const s = document.createElement("script");
      s.src = url;
      s.async = true;
      s.crossOrigin = "anonymous";
      s.onload = function () {
        console.log("[SendPulse] script cargado desde", url);
        btn.disabled = false;
        btn.innerHTML = svgBoton();
        suscribir(accountId);
      };
      s.onerror = function () {
        console.warn("[SendPulse] falló", url);
        if (s.parentNode) s.parentNode.removeChild(s);
        cargarScriptSendPulse(intento + 1);
      };
      document.head.appendChild(s);
    }

    function suscribir(accountId) {
      try {
        if (typeof window.PushSubscriber !== "function") {
          mostrarError("El SDK de SendPulse no se inicializó correctamente. Reintentá.");
          return;
        }
        window.pushSubscriber = new window.PushSubscriber(accountId);
        window.pushSubscriber
          .subscribe()
          .then(function () {
            mostrarExito("¡Listo! Te suscribiste correctamente. Vas a recibir los avisos de actividades.");
            btn.innerHTML = "✓ Suscripto";
            btn.disabled = true;
            btn.classList.add("opacity-60", "cursor-default");
            logSuscripcion();
          })
          .catch(function (err) {
            console.error("[SendPulse] subscribe error", err);
            const msg = err && err.message ? err.message : "desconocido";
            mostrarError("No se pudo completar la suscripción (" + msg + "). Probá de nuevo o revisá los permisos del navegador.");
          });
      } catch (e) {
        console.error("[SendPulse] init error", e);
        mostrarError("Error inesperado: " + (e.message || "sin detalle"));
      }
    }

    function svgBoton() {
      return '<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Quiero recibir notificaciones';
    }

    function mostrarExito(msg) {
      status.className =
        "mt-3 text-sm px-4 py-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300";
      status.textContent = msg;
      status.classList.remove("hidden");
    }

    function mostrarError(msg) {
      status.className = "mt-3 text-sm px-4 py-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-300";
      status.textContent = msg;
      status.classList.remove("hidden");
    }

    function logSuscripcion() {
      if (!apiBase) return;
      try {
        const base = apiBase.replace(/\/$/, "");
        fetch(base + "/suscripciones", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ sendpulse_id: null }),
          mode: "cors",
        });
      } catch (e) {
        console.warn("No se pudo loguear la suscripción:", e);
      }
    }
  })();
</script>