---

<Layout title="Generación de Relevo | JEMS">
  <Header />

  <section class="relative pt-32 pb-20 overflow-hidden bg-[#0c121e]">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-purple-600/10 rounded-full blur-[120px] animate-pulse">
    </div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-[#D4AF37]/5 rounded-full blur-[120px]"></div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="flex flex-col items-center text-center">
        <span
          class="px-4 py-1 rounded-full border border-[#D4AF37]/30 text-[#D4AF37] text-xs font-bold tracking-[0.3em] uppercase mb-6"
        >
          Somos el Ahora
        </span>
        <h1 class="text-6xl md:text-8xl font-black text-white mb-4 tracking-tighter">
          JEMS <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#D4AF37] to-amber-200 italic font-light"
            >Youth</span
          >
        </h1>
        <p class="max-w-2xl text-slate-400 text-lg md:text-xl font-light leading-relaxed">
          Una generación que no se avergüenza del Evangelio. Formando líderes con identidad, propósito y fuego en el
          corazón.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-[#0c121e]">
    <div class="container mx-auto px-6">
      <div class="bg-[#101829] rounded-[40px] p-8 md:p-16 border border-white/5 relative overflow-hidden">
        <div class="flex flex-col lg:flex-row items-center gap-12 relative z-10">
          <div class="w-full lg:w-1/2">
            <div class="relative group">
              <div
                class="absolute -inset-1 bg-gradient-to-r from-[#D4AF37] to-purple-600 rounded-2xl blur opacity-25 group-hover:opacity-50 transition duration-1000"
              >
              </div>
              <Image
                src={fotoPastoresJovenes}
                alt="Pastores de Jóvenes"
                class="relative rounded-2xl shadow-2xl w-full object-cover"
              />
            </div>
          </div>
          <div class="w-full lg:w-1/2">
            <h2 class="text-[#D4AF37] font-bold text-sm uppercase tracking-widest mb-2">Pastores de Jóvenes</h2>
            <h3 class="text-4xl font-bold text-white mb-6 italic">Gabriel & Roselyn</h3>
            <p class="text-slate-300 text-lg leading-relaxed mb-8 font-light">
              Apasionados por ver a la juventud correr hacia su destino profético. Juntos lideran JEMS Youth con una
              visión fresca, combinando la profundidad de la Palabra con la relevancia que demanda esta generación.
            </p>
            <div class="flex gap-4">
              {
                actividades.map((act) => (
                  <div class="flex flex-col">
                    <span class={`w-12 h-1 ${act.color} mb-2`} />
                    <span class="text-white text-xs font-bold uppercase tracking-tighter">{act.etiqueta}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <dialog
        id="foto-modal"
        class="bg-transparent p-0 m-auto rounded-3xl overflow-visible max-w-[min(90vw,520px)] backdrop:bg-black/85 backdrop:backdrop-blur-md"
      >
        <div class="relative">
          <button
            id="foto-modal-close"
            type="button"
            class="absolute -top-3 -right-3 z-10 w-10 h-10 rounded-full bg-[#0c121e] border-2 border-[#D4AF37] text-[#D4AF37] flex items-center justify-center hover:bg-[#D4AF37] hover:text-[#0c121e] transition-colors shadow-xl"
            aria-label="Cerrar"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
          <div
            class="rounded-3xl overflow-hidden bg-[#0c121e] border-2 border-[#D4AF37]/40 shadow-[0_0_80px_-10px_rgba(212,175,55,0.5)]"
          >
            <img id="foto-modal-img" src="" alt="" class="block w-full h-auto max-h-[75vh] object-cover" />
            <div class="px-5 py-4 bg-gradient-to-t from-[#0c121e] to-[#101829] border-t border-white/5">
              <p id="foto-modal-nombre" class="text-white font-black italic text-xl md:text-2xl text-center"></p>
            </div>
          </div>
        </div>
      </dialog>

      <dialog
        id="desglose-modal"
        class="bg-transparent p-0 m-auto rounded-3xl overflow-visible max-w-[min(92vw,460px)] backdrop:bg-black/85 backdrop:backdrop-blur-md"
      >
        <div class="relative">
          <button
            id="desglose-modal-close"
            type="button"
            class="absolute -top-3 -right-3 z-20 w-10 h-10 rounded-full bg-[#0c121e] border-2 border-[#D4AF37] text-[#D4AF37] flex items-center justify-center hover:bg-[#D4AF37] hover:text-[#0c121e] transition-colors shadow-xl"
            aria-label="Cerrar"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
          <div
            class="rounded-3xl overflow-hidden bg-[#0c121e] border-2 border-[#D4AF37]/40 shadow-[0_0_80px_-10px_rgba(212,175,55,0.5)]"
          >
            <div id="desglose-modal-foto-wrap" class="relative bg-[#101829]">
              <img id="desglose-modal-img" src="" alt="" class="block w-full h-60 md:h-72 object-cover" />
              <div
                id="desglose-modal-foto-fallback"
                class="absolute inset-0 hidden items-center justify-center bg-gradient-to-br from-[#101829] to-[#0c121e]"
              >
                <span id="desglose-modal-iniciales" class="text-5xl md:text-6xl font-black text-[#D4AF37]"></span>
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-[#0c121e] via-transparent to-transparent"></div>
              <p
                id="desglose-modal-nombre"
                class="absolute bottom-3 left-0 right-0 text-center text-white font-black italic text-2xl md:text-3xl px-4"
              >
              </p>
            </div>
            <div class="p-5 md:p-6 bg-[#0c121e] border-t border-white/5">
              <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] md:text-xs uppercase tracking-[0.3em] text-[#D4AF37] font-bold">
                  Desglose de Puntos
                </span>
                <div class="flex items-baseline gap-1.5">
                  <span id="desglose-modal-total" class="text-2xl md:text-3xl font-black text-[#D4AF37]"> </span>
                  <span class="text-[10px] uppercase tracking-widest text-white/40">pts</span>
                </div>
              </div>
              <ul
                id="desglose-modal-lista"
                class="divide-y divide-white/5 border-t border-white/5 max-h-[40vh] md:max-h-[45vh] overflow-y-auto"
              >
              </ul>
            </div>
          </div>
        </div>
      </dialog>
    </div>

    <script>
      const fotoModal = document.getElementById("foto-modal") as HTMLDialogElement | null;
      const fotoModalImg = document.getElementById("foto-modal-img") as HTMLImageElement | null;
      const fotoModalNombre = document.getElementById("foto-modal-nombre") as HTMLParagraphElement | null;
      const fotoModalClose = document.getElementById("foto-modal-close");

      if (fotoModal && fotoModalImg && fotoModalNombre) {
        document.querySelectorAll<HTMLButtonElement>("[data-foto-nombre][data-foto-src]").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.stopPropagation();
            const nombre = btn.dataset.fotoNombre || "";
            const src = btn.dataset.fotoSrc || "";
            if (!src) return;
            fotoModalImg.src = src;
            fotoModalImg.alt = nombre;
            fotoModalNombre.textContent = nombre;
            fotoModal.showModal();
          });
        });

        fotoModalClose?.addEventListener("click", () => fotoModal.close());

        fotoModal.addEventListener("click", (e) => {
          const rect = fotoModal.getBoundingClientRect();
          const insideContent =
            e.clientX >= rect.left && e.clientX <= rect.right && e.clientY >= rect.top && e.clientY <= rect.bottom;
          if (!insideContent) fotoModal.close();
        });

        fotoModal.addEventListener("close", () => {
          fotoModalImg.src = "";
          fotoModalImg.alt = "";
        });
      }

      const desgloseModal = document.getElementById("desglose-modal") as HTMLDialogElement | null;
      const desgloseImg = document.getElementById("desglose-modal-img") as HTMLImageElement | null;
      const desgloseFotoFallback = document.getElementById("desglose-modal-foto-fallback");
      const desgloseIniciales =
        document.getElementById("desglose-modal-inicial") ||
        (document.getElementById("desglose-modal-iniciales") as HTMLElement | null);
      const desgloseNombre = document.getElementById("desglose-modal-nombre") as HTMLElement | null;
      const desgloseTotal = document.getElementById("desglose-modal-total") as HTMLElement | null;
      const desgloseLista = document.getElementById("desglose-modal-lista") as HTMLElement | null;
      const desgloseClose = document.getElementById("desglose-modal-close");

      const motivoColor: Record<string, { text: string; bg: string; dot: string; label: string }> = {
        Asistencia: { text: "text-[#D4AF37]", bg: "bg-[#D4AF37]/10", dot: "bg-[#D4AF37]", label: "Asistencia" },
        Participación: {
          text: "text-purple-300",
          bg: "bg-purple-400/10",
          dot: "bg-purple-400",
          label: "Participación",
        },
        Ganador: { text: "text-amber-200", bg: "bg-amber-400/15", dot: "bg-amber-400", label: "Ganador" },
        Constancia: { text: "text-slate-300", bg: "bg-white/5", dot: "bg-slate-400", label: "Constancia" },
      };

      const iniciales = (nombre: string) =>
        nombre
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .substring(0, 2)
          .toUpperCase();

      if (desgloseModal && desgloseImg && desgloseNombre && desgloseTotal && desgloseLista) {
        const abrirDesglose = (row: HTMLElement) => {
          const nombre = row.dataset.rowNombre || "";
          const src = row.dataset.rowSrc || "";
          const total = row.dataset.rowTotal || "0";
          const puntosJson = row.dataset.rowPuntos || "[]";
          let puntos: { motivo: string; puntos: number }[] = [];
          try {
            puntos = JSON.parse(puntosJson);
          } catch {
            puntos = [];
          }

          desgloseNombre.textContent = nombre;
          desgloseTotal.textContent = total;

          if (desgloseIniciales) desgloseIniciales.textContent = iniciales(nombre);

          if (src) {
            desgloseImg.src = src;
            desgloseImg.alt = nombre;
            desgloseImg.classList.remove("hidden");
            desgloseFotoFallback?.classList.add("hidden");
          } else {
            desgloseImg.src = "";
            desgloseImg.alt = "";
            desgloseImg.classList.add("hidden");
            desgloseFotoFallback?.classList.remove("hidden");
            desgloseFotoFallback?.classList.add("flex");
          }

          desgloseLista.innerHTML = "";
          puntos
            .slice()
            .reverse()
            .forEach((p) => {
              const cfg = motivoColor[p.motivo] || {
                text: "text-white",
                bg: "bg-white/5",
                dot: "bg-white/40",
                label: p.motivo,
              };
              const li = document.createElement("li");
              li.className = "flex items-center gap-3 py-2.5";
              li.innerHTML = `
              <span class="shrink-0 w-9 h-9 rounded-lg ${cfg.bg} flex items-center justify-center">
                <span class="w-2 h-2 rounded-full ${cfg.dot}"></span>
              </span>
              <span class="flex-1 text-white text-sm md:text-base">${cfg.label}</span>
              <span class="${cfg.text} font-black text-base md:text-lg tabular-nums">+${p.puntos}</span>
            `;
              desgloseLista.appendChild(li);
            });

          desgloseModal.showModal();
        };

        document.querySelectorAll<HTMLElement>("[data-row-nombre][data-row-puntos]").forEach((row) => {
          row.addEventListener("click", () => abrirDesglose(row));
          row.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              abrirDesglose(row);
            }
          });
        });

        desgloseClose?.addEventListener("click", () => desgloseModal.close());

        desgloseModal.addEventListener("click", (e) => {
          const rect = desgloseModal.getBoundingClientRect();
          const insideContent =
            e.clientX >= rect.left && e.clientX <= rect.right && e.clientY >= rect.top && e.clientY <= rect.bottom;
          if (!insideContent) desgloseModal.close();
        });

        desgloseModal.addEventListener("close", () => {
          desgloseImg.src = "";
          desgloseImg.alt = "";
          desgloseLista.innerHTML = "";
        });
      }
    </script>

    <style>
      dialog#foto-modal,
      dialog#desglose-modal {
        border: none;
      }
      dialog#foto-modal::backdrop,
      dialog#desglose-modal::backdrop {
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
      }
      dialog#desglose-modal {
        animation: desgloseIn 0.25s ease-out;
      }
      @keyframes desgloseIn {
        from {
          opacity: 0;
          transform: translateY(10px) scale(0.98);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }
