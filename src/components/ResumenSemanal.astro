---
import type { Actividad } from "../lib/api";
import {
  formatFechaLarga,
  formatHoraCorta,
  categoriaLabel,
  categoriaColor,
} from "../lib/api";

interface Props {
  actividades: Actividad[];
}

const { actividades } = Astro.props;

const hoy = new Date();
hoy.setHours(0, 0, 0, 0);

const proximaSemana: Actividad[] = [];

for (const a of actividades) {
  if (a.estado === "cancelada") continue;
  const fecha = new Date(a.fecha + "T00:00:00");
  const diffDias = Math.floor((fecha.getTime() - hoy.getTime()) / 86400000);
  if (diffDias >= 0 && diffDias < 7) {
    proximaSemana.push(a);
  }
}

const grouped: Record<string, Actividad[]> = {};
for (const a of proximaSemana) {
  grouped[a.fecha] ??= [];
  grouped[a.fecha].push(a);
}
for (const key of Object.keys(grouped)) {
  grouped[key].sort((a, b) => {
    const ha = a.hora_inicio ?? "";
    const hb = b.hora_inicio ?? "";
    return ha.localeCompare(hb);
  });
}
const orderedDays = Object.keys(grouped).sort();
---

<section class="space-y-3">
  <header class="flex items-baseline justify-between mb-2">
    <h3 class="text-2xl font-bold text-white">Esta semana</h3>
    <span class="text-xs text-slate-400 uppercase tracking-wider">
      {proximaSemana.length} {proximaSemana.length === 1 ? "actividad" : "actividades"}
    </span>
  </header>

  {proximaSemana.length === 0 ? (
    <div class="rounded-2xl border border-dashed border-white/10 p-8 text-center text-slate-400">
      No hay actividades programadas para los próximos 7 días.
    </div>
  ) : (
    <div class="space-y-4">
      {orderedDays.map((fecha) => (
        <div class="rounded-2xl border border-white/5 bg-[#0c121e]/60 overflow-hidden">
          <div class="px-5 py-2 bg-white/5 text-xs uppercase tracking-wider text-[#D4AF37]">
            {formatFechaLarga(fecha)}
          </div>
          <ul class="divide-y divide-white/5">
            {grouped[fecha].map((a) => (
              <li class="px-5 py-4 flex gap-4 hover:bg-white/[0.02] transition">
                <div class="shrink-0 w-16 text-center">
                  {a.hora_inicio ? (
                    <>
                      <p class="text-2xl font-bold text-white leading-none">
                        {formatHoraCorta(a.hora_inicio).split(":")[0]}<span class="text-[#D4AF37]">:</span>{formatHoraCorta(a.hora_inicio).split(":")[1]}
                      </p>
                      <p class="text-[10px] text-slate-500 uppercase tracking-wider mt-1">
                        {a.hora_fin ? `–${formatHoraCorta(a.hora_fin)}` : "hs"}
                      </p>
                    </>
                  ) : (
                    <p class="text-xs text-slate-400 uppercase tracking-wider">Todo el día</p>
                  )}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-start gap-2 flex-wrap">
                    <h4 class="font-semibold text-white">{a.titulo}</h4>
                    <span
                      class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full"
                      style={`background:${categoriaColor(a.categoria)}22;color:${categoriaColor(a.categoria)}`}
                    >
                      {categoriaLabel(a.categoria)}
                    </span>
                    {a.destacado && (
                      <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#D4AF37]/15 text-[#D4AF37]">
                        Destacado
                      </span>
                    )}
                  </div>
                  {a.descripcion && (
                    <p class="text-sm text-slate-400 mt-1 line-clamp-2">{a.descripcion}</p>
                  )}
                  <p class="text-xs text-slate-500 mt-1 flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    {a.lugar}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}
</section>