---
// SendPulse hace todo: el script per-site (cargado en <head> de Layout.astro)
// muestra su propio popup/banner para que el visitante se suscriba.
// Acá solo dejamos un panel informativo para que el usuario sepa qué esperar.
const sendpulseConfigured = ((import.meta.env.PUBLIC_SENDPULSE_ACCOUNT_ID ?? "") as string).trim() !== "";
---

<section
  id="seccion-push"
  class="rounded-2xl border border-[#D4AF37]/20 bg-gradient-to-br from-[#D4AF37]/10 via-[#101829] to-[#101829] p-6 md:p-8"
  style="display:none"
>
  <div class="flex flex-col md:flex-row items-center gap-6">
    <div class="shrink-0 w-16 h-16 rounded-2xl bg-[#D4AF37]/15 text-[#D4AF37] flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
        ></path>
      </svg>
    </div>

    <div class="flex-1 text-center md:text-left">
      <h3 class="text-xl font-bold text-white">¿Querés recibir notificaciones de las actividades?</h3>
      <p class="text-sm text-slate-300 mt-1">
        Te avisamos cada vez que publiquemos un culto, estudio bíblico o evento especial.
      </p>

      {
        sendpulseConfigured ? (
          <p class="text-xs text-slate-400 mt-3 leading-relaxed">
            Al cargar la página, <strong class="text-[#D4AF37]">SendPulse</strong> te muestra un pequeño banner o botón
            (generalmente abajo a la derecha). Hacé clic ahí y aceptá el permiso del navegador para suscribirte. Las
            notificaciones las envía la iglesia directamente desde el panel administrativo.
          </p>
        ) : (
          <p class="text-xs text-amber-300 mt-3 leading-relaxed">
            ⚠️ Falta configurar <code class="bg-black/30 px-1 rounded">PUBLIC_SENDPULSE_ACCOUNT_ID</code> en el
            servidor. Pedile al administrador que lo configure.
          </p>
        )
      }
    </div>
  </div>
</section>
