---
import type { Actividad } from "../lib/api";
import ResumenSemanal from "./ResumenSemanal.astro";
import CalendarioActividades from "./CalendarioActividades.astro";
import BotonNotificaciones from "./BotonNotificaciones.astro";

interface Props {
  apiUrl?: string;
  mostrarCalendario?: boolean;
  mostrarResumen?: boolean;
  mostrarBotonPush?: boolean;
}

const {
  mostrarCalendario = true,
  mostrarResumen = true,
  mostrarBotonPush = true,
} = Astro.props;

let actividades: Actividad[] = [];
let errorCarga: string | null = null;

try {
  const apiModule = await import("../lib/api");
  const hoy = new Date().toISOString().slice(0, 10);
  const futuro = new Date();
  futuro.setMonth(futuro.getMonth() + 6);
  const hasta = futuro.toISOString().slice(0, 10);
  actividades = await apiModule.fetchActividades({ desde: hoy, hasta });
} catch (e) {
  errorCarga = e instanceof Error ? e.message : "No se pudieron cargar las actividades";
}
---

<section id="actividades" class="py-20 bg-[#101829] relative overflow-hidden">
  <div class="absolute top-0 left-0 w-96 h-96 bg-[#D4AF37]/5 rounded-full blur-[100px] -z-10"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-blue-500/5 rounded-full blur-[100px] -z-10"></div>

  <div class="container mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-4">Actividades</h2>
      <p class="text-slate-400 max-w-2xl mx-auto">
        Conocé todo lo que tenemos preparado para vos y tu familia esta semana y las próximas.
      </p>
    </div>

    {errorCarga && (
      <div class="mb-8 px-4 py-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-300 text-sm text-center">
        No se pudieron cargar las actividades en este momento ({errorCarga}). Reintentá más tarde.
      </div>
    )}

    <div class="grid lg:grid-cols-5 gap-8">
      <div class="lg:col-span-2 space-y-4">
        {mostrarResumen && <ResumenSemanal actividades={actividades} />}
      </div>

      {mostrarCalendario && (
        <div class="lg:col-span-3">
          <CalendarioActividades actividades={actividades} />
        </div>
      )}
    </div>

    {mostrarBotonPush && (
      <div class="mt-12 max-w-3xl mx-auto">
        <BotonNotificaciones />
      </div>
    )}
  </div>
</section>
