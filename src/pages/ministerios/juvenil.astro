---
import { Image, type ImageMetadata } from "astro:assets";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";

// Importa tus imágenes aquí
import fotoAranza from "../../assets/images/jovenes/Aranza.jpg";
import fotoEnio from "../../assets/images/jovenes/Enio.jpg";
import fotoErika from "../../assets/images/jovenes/Erika.jpg";
import fotoJonas from "../../assets/images/jovenes/Jonas.jpg";
import fotoJonathan from "../../assets/images/jovenes/Jonathan.jpg";
import fotoNicol from "../../assets/images/jovenes/Nicol.jpg";
import fotoReyber from "../../assets/images/jovenes/Reyber.jpg";
import fotoReynaldo from "../../assets/images/jovenes/Reynaldo.jpg";
import fotoRichelis from "../../assets/images/jovenes/Richelis.jpg";
import fotoSamuel from "../../assets/images/jovenes/Samuel.jpg";
import fotoSariel from "../../assets/images/jovenes/Sariel.jpg";
import fotoVictoria from "../../assets/images/jovenes/Victoria.jpg";
import fotoYsmael from "../../assets/images/jovenes/Ysmael.jpg";
import galeria1 from "../../assets/images/jovenes1.png";
import galeria10 from "../../assets/images/jovenes10.png";
import galeria2 from "../../assets/images/jovenes2.png";
import galeria3 from "../../assets/images/jovenes3.png";
import galeria4 from "../../assets/images/jovenes4.png";
import galeria5 from "../../assets/images/jovenes5.png";
import galeria6 from "../../assets/images/jovenes6.png";
import galeria7 from "../../assets/images/jovenes7.png";
import galeria8 from "../../assets/images/jovenes8.png";
import galeria9 from "../../assets/images/jovenes9.png";
import fotoPastoresJovenes from "../../assets/images/pastoresjuveniles.png";

const actividades = [
  { etiqueta: "Conexión", titulo: "Noches de Fuego", color: "bg-orange-500" },
  { etiqueta: "Crecimiento", titulo: "Discipulado Pro", color: "bg-blue-500" },
  { etiqueta: "Impacto", titulo: "Misiones Urbanas", color: "bg-purple-500" },
];

const fotosJovenes: Record<string, ImageMetadata> = {
  Aranza: fotoAranza,
  Enio: fotoEnio,
  Erika: fotoErika,
  Jonas: fotoJonas,
  Jonathan: fotoJonathan,
  Nicol: fotoNicol,
  Reyber: fotoReyber,
  Reynaldo: fotoReynaldo,
  Richelis: fotoRichelis,
  Samuel: fotoSamuel,
  Sariel: fotoSariel,
  Victoria: fotoVictoria,
  Ysmael: fotoYsmael,
};

const iniciales = (nombre: string) =>
  nombre
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .substring(0, 2)
    .toUpperCase();

const ranking = [
  // domingo 13/09
  { nombre: "Alexander", asistencia: true, participacion: false, ganador: false, total: 10 },
  { nombre: "Angelo", asistencia: true, participacion: false, ganador: false, total: 20 },
  { nombre: "Aranza", asistencia: true, participacion: true, ganador: false, total: 35 },
  { nombre: "David", asistencia: true, participacion: true, ganador: false, total: 15 },
  { nombre: "Efranny", asistencia: true, participacion: false, ganador: false, total: 30 },
  { nombre: "Enio", asistencia: true, participacion: false, ganador: true, total: 45 },
  { nombre: "Erika", asistencia: true, participacion: true, ganador: false, total: 35 },
  { nombre: "Franklin", asistencia: true, participacion: true, ganador: false, total: 25 },
  { nombre: "Jonas", asistencia: true, participacion: true, ganador: false, total: 25 },
  { nombre: "Jonathan", asistencia: true, participacion: true, ganador: false, total: 35 },
  { nombre: "Kate", asistencia: true, participacion: true, ganador: false, total: 15 },
  { nombre: "Nana", asistencia: true, participacion: false, ganador: false, total: 10 },
  { nombre: "Naya", asistencia: true, participacion: false, ganador: true, total: 35 },
  { nombre: "Nicol", asistencia: false, participacion: false, ganador: false, total: 10 },
  { nombre: "Reyber", asistencia: true, participacion: true, ganador: true, total: 60 },
  { nombre: "Reynaldo", asistencia: false, participacion: false, ganador: false, total: 10 },
  { nombre: "Richelis", asistencia: true, participacion: true, ganador: false, total: 25 },
  { nombre: "Samuel", asistencia: false, participacion: false, ganador: false, total: 10 },
  { nombre: "Sariel", asistencia: true, participacion: true, ganador: true, total: 60 },
  { nombre: "Victoria", asistencia: false, participacion: false, ganador: false, total: 10 },
  { nombre: "Ysmael", asistencia: false, participacion: false, ganador: false, total: 10 },
];

ranking.sort((a, b) => b.total - a.total || a.nombre.localeCompare(b.nombre));
---

<Layout title="Generación de Relevo | JEMS">
  <Header />

  <section class="relative pt-32 pb-20 overflow-hidden bg-[#0c121e]">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-purple-600/10 rounded-full blur-[120px] animate-pulse">
    </div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-[#D4AF37]/5 rounded-full blur-[120px]"></div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="flex flex-col items-center text-center">
        <span
          class="px-4 py-1 rounded-full border border-[#D4AF37]/30 text-[#D4AF37] text-xs font-bold tracking-[0.3em] uppercase mb-6"
        >
          Somos el Ahora
        </span>
        <h1 class="text-6xl md:text-8xl font-black text-white mb-4 tracking-tighter">
          JEMS <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#D4AF37] to-amber-200 italic font-light"
            >Youth</span
          >
        </h1>
        <p class="max-w-2xl text-slate-400 text-lg md:text-xl font-light leading-relaxed">
          Una generación que no se avergüenza del Evangelio. Formando líderes con identidad, propósito y fuego en el
          corazón.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-[#0c121e]">
    <div class="container mx-auto px-6">
      <div class="bg-[#101829] rounded-[40px] p-8 md:p-16 border border-white/5 relative overflow-hidden">
        <div class="flex flex-col lg:flex-row items-center gap-12 relative z-10">
          <div class="w-full lg:w-1/2">
            <div class="relative group">
              <div
                class="absolute -inset-1 bg-gradient-to-r from-[#D4AF37] to-purple-600 rounded-2xl blur opacity-25 group-hover:opacity-50 transition duration-1000"
              >
              </div>
              <Image
                src={fotoPastoresJovenes}
                alt="Pastores de Jóvenes"
                class="relative rounded-2xl shadow-2xl w-full object-cover"
              />
            </div>
          </div>
          <div class="w-full lg:w-1/2">
            <h2 class="text-[#D4AF37] font-bold text-sm uppercase tracking-widest mb-2">Pastores de Jóvenes</h2>
            <h3 class="text-4xl font-bold text-white mb-6 italic">Gabriel & Roselyn</h3>
            <p class="text-slate-300 text-lg leading-relaxed mb-8 font-light">
              Apasionados por ver a la juventud correr hacia su destino profético. Juntos lideran JEMS Youth con una
              visión fresca, combinando la profundidad de la Palabra con la relevancia que demanda esta generación.
            </p>
            <div class="flex gap-4">
              {
                actividades.map((act) => (
                  <div class="flex flex-col">
                    <span class={`w-12 h-1 ${act.color} mb-2`} />
                    <span class="text-white text-xs font-bold uppercase tracking-tighter">{act.etiqueta}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-[#0c121e]">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold text-white mb-12 italic text-center md:text-left">
        Nuestra <span class="text-[#D4AF37]">Vida</span> en Comunidad
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 auto-rows-[200px] md:auto-rows-[250px]">
        <div class="md:col-span-2 md:row-span-2 relative group overflow-hidden rounded-3xl">
          <Image
            src={galeria1}
            alt="Evento Joven"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-8"
          >
            <p class="text-white font-bold italic text-xl">Cena Navideña</p>
          </div>
        </div>

        <div class="md:col-span-1 md:row-span-2 relative group overflow-hidden rounded-3xl">
          <Image
            src={galeria2}
            alt="Alabanza"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-8"
          >
            <p class="text-white font-bold italic text-xl">Fogatas</p>
          </div>
        </div>

        <div class="md:col-span-1 md:row-span-1 relative group overflow-hidden rounded-3xl">
          <Image
            src={galeria3}
            alt="Amistad"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>

        <div class="md:col-span-1 md:row-span-1 relative group overflow-hidden rounded-3xl">
          <Image
            src={galeria4}
            alt="Servicio"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>

        <div class="md:col-span-4 md:row-span-1 relative group overflow-hidden rounded-3xl">
          <Image
            src={galeria10}
            alt="Comunidad"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
          <div
            class="absolute inset-0 flex items-center justify-center bg-black/40 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-all"
          >
            <span class="text-white font-serif italic text-3xl">#SomosJEMSYouth</span>
          </div>
        </div>

        <div class="md:col-span-1 md:row-span-1 relative group overflow-hidden rounded-3xl">
          <Image
            src={galeria6}
            alt="Actividades"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>

        <div class="md:col-span-2 md:row-span-1 relative group overflow-hidden rounded-3xl">
          <Image
            src={galeria7}
            alt="Momentos"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>

        <div class="md:col-span-1 md:row-span-2 relative group overflow-hidden rounded-3xl">
          <Image
            src={galeria8}
            alt="Liderazgo"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>

        <div class="md:col-span-1 md:row-span-1 relative group overflow-hidden rounded-3xl">
          <Image
            src={galeria9}
            alt="Sonrisas"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>

        <div class="md:col-span-2 md:row-span-1 relative group overflow-hidden rounded-3xl">
          <Image
            src={galeria5}
            alt="Cierre"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-[#101829]">
    <div class="container mx-auto px-6 text-center">
      <p class="text-[#D4AF37] text-4xl md:text-6xl font-serif italic max-w-4xl mx-auto leading-tight">
        "No permitas que nadie menosprecie tu juventud..."
      </p>
      <p class="text-white/40 mt-6 tracking-[0.5em] uppercase text-sm font-bold">1 Timoteo 4:12</p>
    </div>
  </section>

  <section class="py-24 bg-[#0c121e] relative overflow-hidden">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[#D4AF37]/5 rounded-full blur-[140px]"
    >
    </div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span
          class="px-4 py-1 rounded-full border border-[#D4AF37]/30 text-[#D4AF37] text-xs font-bold tracking-[0.3em] uppercase mb-6 inline-block"
        >
          Ranking de Puntos
        </span>
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6 italic leading-tight">
          Nuestra <span class="text-[#D4AF37]">Generación</span> en Marcha
        </h2>
        <p class="text-slate-400 text-lg font-light">
          Cada reunión suma. Aquí celebramos la constancia y la entrega de quienes hacen vibrar JEMS Youth.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-3 mb-16 text-sm">
        <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            stroke="currentColor"
            class="w-4 h-4 text-[#D4AF37]"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
          </svg>
          <span class="text-slate-300"><span class="text-white font-bold">Asistencia</span></span>
        </div>
        <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="w-4 h-4 text-purple-400"
          >
            <circle cx="12" cy="12" r="6"></circle>
          </svg>
          <span class="text-slate-300"><span class="text-white font-bold">Participación</span></span>
        </div>
        <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="w-4 h-4 text-amber-300"
          >
            <path
              d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.563 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"
            ></path>
          </svg>
          <span class="text-slate-300"><span class="text-white font-bold">Ganador</span></span>
        </div>
      </div>

      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 items-end mb-16">
        {
          ranking.slice(0, 3).map((joven, idx) => {
            const podiumOrder = ["md:order-2", "md:order-1", "md:order-3"];
            const medals = [
              {
                label: "1º Lugar",
                color: "from-[#D4AF37] to-amber-200",
                text: "text-[#D4AF37]",
                ring: "border-[#D4AF37]/50",
                shadow: "shadow-[0_0_50px_-15px_rgba(212,175,55,0.5)]",
                isFirst: true,
              },
              {
                label: "2º Lugar",
                color: "from-slate-200 to-slate-400",
                text: "text-slate-200",
                ring: "border-slate-300/40",
                shadow: "shadow-[0_0_30px_-15px_rgba(226,232,240,0.3)]",
                isFirst: false,
              },
              {
                label: "3º Lugar",
                color: "from-amber-600 to-amber-800",
                text: "text-amber-500",
                ring: "border-amber-600/40",
                shadow: "shadow-[0_0_30px_-15px_rgba(217,119,6,0.3)]",
                isFirst: false,
              },
            ];
            const medal = medals[idx];
            return (
              <div
                class={`relative rounded-3xl p-[2px] bg-gradient-to-br ${medal.color} ${medal.shadow} ${podiumOrder[idx]} ${medal.isFirst ? "md:scale-105 md:-translate-y-3" : ""}`}
              >
                <div
                  class={`rounded-3xl bg-[#0c121e] flex flex-col items-center justify-center p-6 md:p-8 ${medal.ring} border-2`}
                >
                  <div class={`text-[10px] md:text-xs font-bold uppercase tracking-[0.3em] mb-4 md:mb-5 ${medal.text}`}>
                    {medal.label}
                  </div>
                  <div
                    class={`w-28 h-28 md:w-36 md:h-36 rounded-full bg-gradient-to-br ${medal.color} p-[3px] mb-5 md:mb-6 shadow-xl`}
                  >
                    <div class="w-full h-full rounded-full overflow-hidden bg-[#0c121e] flex items-center justify-center">
                      {fotosJovenes[joven.nombre] ? (
                        <Image
                          src={fotosJovenes[joven.nombre]}
                          alt={joven.nombre}
                          width={288}
                          height={288}
                          class="w-full h-full object-cover"
                        />
                      ) : (
                        <span class={`text-3xl md:text-4xl font-black ${medal.text}`}>{iniciales(joven.nombre)}</span>
                      )}
                    </div>
                  </div>
                  <h3 class="text-2xl md:text-3xl font-black text-white italic mb-2 text-center break-words max-w-full">
                    {joven.nombre}
                  </h3>
                  <div class={`text-4xl md:text-5xl font-black ${medal.text}`}>{joven.total}</div>
                  <div class="text-[10px] md:text-xs uppercase tracking-widest text-white/40 mt-1">puntos</div>
                </div>
              </div>
            );
          })
        }
      </div>

      <div class="bg-[#101829] rounded-3xl border border-white/5 overflow-hidden">
        <div class="px-4 md:px-6 py-4 border-b border-white/5 flex items-center justify-between">
          <h3 class="text-white font-bold italic text-lg">Tabla General</h3>
          <span class="text-xs text-white/40 uppercase tracking-widest">{ranking.length} jóvenes</span>
        </div>
        <div class="divide-y divide-white/5">
          {
            ranking.map((joven, idx) => (
              <div class="flex items-center gap-3 md:gap-4 px-4 md:px-6 py-4 hover:bg-white/[0.02] transition-colors">
                <div
                  class={`w-12 h-12 md:w-14 md:h-14 rounded-xl flex items-center justify-center font-black text-sm md:text-base shrink-0 ${
                    idx === 0
                      ? "bg-[#D4AF37] text-[#0c121e]"
                      : idx === 1
                        ? "bg-slate-300 text-[#0c121e]"
                        : idx === 2
                          ? "bg-amber-700 text-white"
                          : "bg-white/5 text-white/60"
                  }`}
                >
                  {idx + 1}
                </div>
                <div
                  class={`shrink-0 w-12 h-12 md:w-14 md:h-14 rounded-full p-[2px] ${
                    idx < 3
                      ? "bg-gradient-to-br " +
                        (idx === 0
                          ? "from-[#D4AF37] to-amber-200"
                          : idx === 1
                            ? "from-slate-200 to-slate-400"
                            : "from-amber-600 to-amber-800")
                      : "bg-white/10"
                  }`}
                >
                  <div class="w-full h-full rounded-full overflow-hidden bg-[#0c121e] flex items-center justify-center">
                    {fotosJovenes[joven.nombre] ? (
                      <Image
                        src={fotosJovenes[joven.nombre]}
                        alt={joven.nombre}
                        width={112}
                        height={112}
                        class="w-full h-full object-cover"
                      />
                    ) : (
                      <span class={`text-xs md:text-sm font-black ${idx < 3 ? "text-[#D4AF37]" : "text-white/60"}`}>
                        {iniciales(joven.nombre)}
                      </span>
                    )}
                  </div>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-white font-semibold italic truncate">{joven.nombre}</div>
                  <div class="flex flex-wrap gap-1.5 mt-1">
                    {joven.asistencia && (
                      <span class="inline-flex items-center gap-1 text-[10px] uppercase tracking-wider text-[#D4AF37] bg-[#D4AF37]/10 px-2 py-0.5 rounded-full">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke-width="3"
                          stroke="currentColor"
                          class="w-2.5 h-2.5"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                        <span class="hidden sm:inline">Asistencia</span>
                      </span>
                    )}
                    {joven.participacion && (
                      <span class="inline-flex items-center gap-1 text-[10px] uppercase tracking-wider text-purple-300 bg-purple-400/10 px-2 py-0.5 rounded-full">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-2 h-2">
                          <circle cx="12" cy="12" r="6" />
                        </svg>
                        <span class="hidden sm:inline">Participación</span>
                      </span>
                    )}
                    {joven.ganador && (
                      <span class="inline-flex items-center gap-1 text-[10px] uppercase tracking-wider text-amber-200 bg-amber-400/15 border border-amber-400/30 px-2 py-0.5 rounded-full">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          class="w-2.5 h-2.5"
                        >
                          <path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.563 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                        </svg>
                        <span class="hidden sm:inline">Ganador</span>
                      </span>
                    )}
                  </div>
                </div>
                <div class="text-right shrink-0">
                  <div class={`text-xl md:text-2xl font-black ${idx < 3 ? "text-[#D4AF37]" : "text-white"}`}>
                    {joven.total}
                  </div>
                  <div class="text-[10px] uppercase tracking-widest text-white/40">puntos</div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="relative mt-10 overflow-hidden rounded-3xl border border-[#D4AF37]/30 bg-gradient-to-br from-[#D4AF37]/10 via-[#101829] to-purple-600/10 p-6 md:p-10"
      >
