---
import type { Actividad } from "../lib/api";
import { buildResumenHTML, buildResumenHeader } from "../lib/resumen";

interface Props {
  actividades: Actividad[];
}

const { actividades } = Astro.props;

const headerHtml = buildResumenHeader(actividades);
const bodyHtml = buildResumenHTML(actividades);
---

<section class="space-y-3">
  <div id="resumen-header" set:html={headerHtml}></div>
  <div id="resumen-body" set:html={bodyHtml}></div>
</section>

<script>
  import type { Actividad } from "../lib/api";
  import { buildResumenHTML, buildResumenHeader } from "../lib/resumen";

  const headerEl = document.getElementById("resumen-header");
  const bodyEl = document.getElementById("resumen-body");

  function getApiBase(): string {
    const env = (import.meta.env.PUBLIC_ACTIVIDADES_API ?? "").trim().replace(/\/+$/, "");
    return env === "" ? "https://api.micasajems.com/api" : env;
  }

  function toDateStr(value: unknown): string {
    if (!value) return "";
    return String(value).slice(0, 10);
  }

  function isValidDateStr(s: unknown): s is string {
    return typeof s === "string" && /^\d{4}-\d{2}-\d{2}$/.test(s);
  }

  function asCategoria(v: unknown): Actividad["categoria"] {
    const cats: Actividad["categoria"][] = ["culto", "estudio", "evento", "ministerio", "social", "otro"];
    return cats.includes(v as Actividad["categoria"]) ? (v as Actividad["categoria"]) : "otro";
  }

  function asEstado(v: unknown): Actividad["estado"] {
    if (v === "cancelada" || v === "realizada" || v === "programada") return v;
    return "programada";
  }

  function normalizeActividad(raw: unknown): Actividad | null {
    const r = (raw ?? {}) as Record<string, unknown>;
    if (!isValidDateStr(r.fecha)) return null;
    return {
      id: Number(r.id) || 0,
      titulo: String(r.titulo ?? ""),
      descripcion: r.descripcion == null ? null : String(r.descripcion),
      lugar: r.lugar == null ? null : String(r.lugar),
      fecha: toDateStr(r.fecha),
      hora_inicio: r.hora_inicio == null || r.hora_inicio === "" ? null : String(r.hora_inicio),
      hora_fin: r.hora_fin == null || r.hora_fin === "" ? null : String(r.hora_fin),
      categoria: asCategoria(r.categoria),
      destacado: Boolean(Number(r.destacado) || r.destacado === true),
      estado: asEstado(r.estado),
      creado_por_nombre: r.creado_por_nombre == null ? undefined : String(r.creado_por_nombre),
    };
  }

  async function fetchActividades(desde: string, hasta: string): Promise<Actividad[]> {
    const base = getApiBase();
    const url =
      base + "/get_actividades.php" +
      "?desde=" + encodeURIComponent(desde) +
      "&hasta=" + encodeURIComponent(hasta);
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 9000);
    try {
      const res = await fetch(url, {
        method: "GET",
        headers: { Accept: "application/json" },
        signal: controller.signal,
      });
      if (!res.ok) throw new Error("HTTP " + res.status);
      const data = await res.json();
      if (!Array.isArray(data)) throw new Error("Respuesta no válida");
      return data.map(normalizeActividad).filter((x): x is Actividad => x !== null);
    } finally {
      clearTimeout(timeoutId);
    }
  }

  function render(actividades: Actividad[]): void {
    if (headerEl) headerEl.innerHTML = buildResumenHeader(actividades);
    if (bodyEl) bodyEl.innerHTML = buildResumenHTML(actividades);
  }

  async function refresh(): Promise<void> {
    try {
      const hoy = new Date().toISOString().slice(0, 10);
      const futuro = new Date();
      futuro.setMonth(futuro.getMonth() + 6);
      const hasta = futuro.toISOString().slice(0, 10);
      const actividades = await fetchActividades(hoy, hasta);
      render(actividades);
    } catch (err) {
      // Si falla, dejamos el seed del SSR. Solo logueamos.
      console.warn("[resumen] no se pudo refrescar, se mantiene el seed SSR", err);
    }
  }

  // Refresco silencioso apenas carga la página (no hay loading).
  // Si la API trae algo distinto al seed, reemplazamos el HTML.
  setTimeout(() => {
    refresh();
  }, 300);

  // Revalidar al volver a la pestaña / recuperar foco.
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) refresh();
  });
  window.addEventListener("focus", refresh);
</script>
